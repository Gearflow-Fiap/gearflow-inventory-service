{
  "info": {
    "name": "gearflow-inventory-service",
    "description": "API do Inventory Service (estoque de peças e insumos + consulta de reservas da Saga).\n\n1. Suba a API (`dotnet run --project src/GearFlow.Inventory.Api`, porta 5081) ou aponte `baseUrl` para o cluster.\n2. Gere um JWT de desenvolvimento: `.\\scripts\\New-DevToken.ps1` e cole em `token` (variável da collection ou do environment).\n3. Rode a collection (Runner) na ordem das pastas. Cada requisição traz testes de status e de contrato.\n\nDocumentação interativa: `{{baseUrl}}/scalar/v1`. Contrato: `{{baseUrl}}/openapi/v1.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5081"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "partId",
      "value": ""
    },
    {
      "key": "consumableId",
      "value": ""
    },
    {
      "key": "serviceOrderId",
      "value": "11111111-1111-1111-1111-111111111111"
    }
  ],
  "item": [
    {
      "name": "Peças",
      "description": "Rodar na ordem: o POST guarda o id em {{partId}} e o DELETE no final apaga só a peça criada aqui (o catálogo de demonstração fica intacto).",
      "item": [
        {
          "name": "Cadastra uma peça",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/parts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "parts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vela de ignição\",\n  \"description\": \"Vela iridium\",\n  \"partNumber\": \"V-1\",\n  \"manufacturer\": \"NGK\",\n  \"priceCents\": 4500,\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('devolve o id e o saldo', () => { pm.expect(body.id).to.be.a('string'); pm.expect(body.quantity).to.eql(10); });",
                  "pm.collectionVariables.set('partId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Lista as peças",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/parts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "parts"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('é uma lista com a peça criada', () => { const ids = pm.response.json().map(p => p.id); pm.expect(ids).to.include(pm.collectionVariables.get('partId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Busca uma peça por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/parts/{{partId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "parts",
                "{{partId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualiza uma peça",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/parts/{{partId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "parts",
                "{{partId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vela de ignição (atualizada)\",\n  \"description\": \"Vela iridium\",\n  \"partNumber\": \"V-1\",\n  \"manufacturer\": \"NGK\",\n  \"priceCents\": 4800,\n  \"quantity\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('preço atualizado', () => pm.expect(pm.response.json().priceCents).to.eql(4800));"
                ]
              }
            }
          ]
        },
        {
          "name": "Adiciona estoque a uma peça",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/parts/{{partId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "parts",
                "{{partId}}",
                "stock"
              ]
            },
            "description": "Soma ao disponível e publica o evento inventory.stock-replenished (o orquestrador reenvia ReserveStock das OS que aguardavam).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('saldo somado (12 + 10)', () => pm.expect(pm.response.json().quantity).to.eql(22));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove uma peça",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/parts/{{partId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "parts",
                "{{partId}}"
              ]
            },
            "description": "204 se não há unidade reservada por OS; 409 (Part.HasActiveReservations) se houver."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
