    {
      "name": "Reservas (Saga)",
      "description": "Só leitura. Reservar, liberar e consumir são comandos da Saga pelo RabbitMQ (ReserveStock, ReleaseStock, ConsumeStock), nunca REST. Para criar uma reserva use o simulador (dotnet run --project tools/GearFlow.Inventory.SagaSimulator -- reserve --order <guid> ...) e coloque o mesmo guid em {{serviceOrderId}}.",
      "item": [
        {
          "name": "Consulta a reserva de uma OS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/reservations/service-order/{{serviceOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "reservations",
                "service-order",
                "{{serviceOrderId}}"
              ]
            },
            "description": "200 com status (Reserved, Released ou Consumed) e as linhas; 404 se a OS não tem reserva."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 (há reserva) ou 404 (OS sem reserva)', () => pm.expect([200, 404]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.test('status válido', () => pm.expect(['Reserved', 'Released', 'Consumed']).to.include(pm.response.json().status));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Erros esperados",
      "description": "Contrato de erro: ProblemDetails com o campo `code`.",
      "item": [
        {
          "name": "400: peça sem nome",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/parts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "parts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"description\": \"Vela iridium\",\n  \"partNumber\": \"V-1\",\n  \"manufacturer\": \"NGK\",\n  \"priceCents\": 4500,\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('code = Part.NameRequired', () => pm.expect(JSON.stringify(pm.response.json())).to.include('Part.NameRequired'));"
                ]
              }
            }
          ]
        },
